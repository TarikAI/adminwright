# Text files are LF in the repository AND in the working tree, on every platform
# (`eol=lf`): a Windows checkout does not get CRLF. Diffs are readable and the
# scripts, fixtures and expectations are byte-identical on every runner.
* text=auto eol=lf

# Shell scripts must keep LF even on Windows checkouts.
*.sh text eol=lf

# Binary-ish assets, never touched.
*.png binary
*.jpg binary
*.zip binary
