// Adminwright admin control-plane core schema — Prisma
//
// Translation of postgres.sql, kept in step with it by tests/test_core_schema.py.
// Read ./README.md before adapting.
//
// PRISMA VERSIONS. Written for Prisma 7 (validated with `prisma validate` on 7.10).
// Prisma 7 no longer accepts `url` in the datasource block: put the connection in
// prisma.config.ts,
//     import { defineConfig } from "prisma/config";
//     export default defineConfig({
//       schema: "prisma/schema.prisma",
//       datasource: { url: process.env.DATABASE_URL },
//     });
// On Prisma 6 and earlier, add `url = env("DATABASE_URL")` to the datasource below
// and drop prisma.config.ts.
//
// WHAT PRISMA CANNOT ENFORCE — all of it is written out in ./prisma_raw.sql, which you
// append to the migration created with `prisma migrate dev --create-only`. It is not
// optional, and it is not a sketch: it is the complete list.
//
//   1. CHECK constraints. Prisma has no CHECK support. The enum-like columns below
//      are native PostgreSQL enums (a database-level constraint, with @map keeping
//      the canonical strings), so the CHECKs that remain are the cross-column and
//      numeric ones: no self-grant, revocation completeness, grant window,
//      impersonation bounds, min approvals, job counts, secret_ref, legal hold.
//   2. Partial and expression indexes. Prisma turns none of these into a WHERE or
//      COALESCE index, so they are left out of this file rather than emitted as full
//      indexes: live-grant uniqueness, job idempotency, the one-live-impersonation
//      index, the queue indexes and the per-scope config uniqueness.
//   3. Triggers and functions. Append-only enforcement on audit_event and
//      approval_decision (UPDATE / DELETE / TRUNCATE), the audit hash chain (the
//      trigger assigns chain_seq, prev_hash, row_hash — the placeholder defaults
//      below are overwritten), verify_audit_chain(), scrub_audit_payload(), the
//      separation-of-duties trigger, and the trigger that keeps an approval_request
//      as written (only state, executed_at and execution_result change).
//
// Then run grants.sql (psql) for the regulated profile.
//
// DIFFERENCES FROM postgres.sql that Prisma imposes:
//   * Every relation states onDelete explicitly. Prisma's default for an optional
//     relation is SetNull, which would erase audit_event.actor_id and the
//     revoked_by columns when an actor row is deleted; here they all block.
//   * Prisma emits ON UPDATE CASCADE by default (postgres.sql uses NO ACTION). It only
//     matters if you rewrite referenced keys such as admin_permission.key.
//   * chain_seq and row_hash have placeholder defaults (0 and "") because the client
//     requires a value; the BEFORE INSERT trigger overwrites them.
//   * admin_actor.email is text rather than citext.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminActorKind {
  human
  service
  agent
}

enum AuthStrength {
  password
  mfa
  phishing_resistant @map("phishing-resistant")
  sso
}

enum RiskLevel {
  low
  moderate
  high
  critical
}

enum AuditActorKind {
  human
  service
  agent
  system
}

enum AuditResult {
  succeeded
  failed
  denied
  partial
  unknown
}

enum ApprovalState {
  pending
  approved
  rejected
  expired
  executed
  execution_failed
  cancelled
}

enum ApprovalDecisionKind {
  approved
  rejected
}

enum JobState {
  queued
  running
  succeeded
  partial
  failed
  cancelled
  expired
}

enum ViewVisibility {
  private
  shared
}

enum ExportState {
  queued
  running
  ready
  failed
  expired
  revoked
}

enum DsrKind {
  access
  erasure
  rectification
  portability
  restriction
  objection
}

enum DsrState {
  open
  in_progress @map("in-progress")
  fulfilled
  refused
  withdrawn
}

enum ConfigTarget {
  config_setting
  feature_flag
}

// ---------------------------------------------------------------------------
// Actors, roles, permissions, grants
// ---------------------------------------------------------------------------

/// Drop this model and add isPrivileged / authStrength / mfaEnrolled to the app's
/// user model when operators share the product's lifecycle and identity provider.
/// Credentials are never stored here; authSubject holds the IdP subject claim.
model AdminActor {
  id             BigInt         @id @default(autoincrement())
  actorUuid      String         @unique @default(dbgenerated("gen_random_uuid()")) @map("actor_uuid") @db.Uuid
  appUserId      BigInt?        @map("app_user_id")
  authSubject    String         @unique @map("auth_subject")
  displayName    String         @map("display_name")
  email          String?
  kind           AdminActorKind @default(human)
  authStrength   AuthStrength   @default(password) @map("auth_strength")
  mfaEnrolled    Boolean        @default(false) @map("mfa_enrolled")
  isActive       Boolean        @default(true) @map("is_active")
  deactivatedAt  DateTime?      @map("deactivated_at") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  grantsHeld     AdminActorRole[] @relation("GrantHolder")
  grantsIssued   AdminActorRole[] @relation("GrantIssuer")
  grantsRevoked  AdminActorRole[] @relation("GrantRevoker")
  auditActed     AuditEvent[]     @relation("AuditActor")
  impersonations ImpersonationSession[] @relation("Impersonator")
  impersonationRevocations ImpersonationSession[] @relation("ImpersonationRevoker")
  approvalsRequested ApprovalRequest[]
  approvalDecisions  ApprovalDecision[]
  jobs           AdminJob[]
  savedViews     SavedView[]
  configChanges  ConfigChange[]
  exports        ExportRequest[]
  dsrAssignments DataSubjectRequest[]

  @@map("admin_actor")
}

model AdminRole {
  id          BigInt  @id @default(autoincrement())
  key         String  @unique // matches manifest roles[].id
  name        String
  description String  @default("")
  requiresMfa Boolean @default(true) @map("requires_mfa")
  maxScope    Json    @default("{}") @map("max_scope")
  isActive    Boolean @default(true) @map("is_active")

  permissions AdminRolePermission[]
  grants      AdminActorRole[]

  @@map("admin_role")
}

/// Key it <resource>.<action> so it equals the manifest capability.id exactly.
/// That equality is what makes capability -> permission -> audit_event.action
/// traceable. Obligations live here, not at the call site, so a new call site
/// cannot silently skip them.
model AdminPermission {
  id               BigInt    @id @default(autoincrement())
  key              String    @unique // manifest capability.id
  resource         String
  action           String
  risk             RiskLevel @default(low)
  requiresReason   Boolean   @default(false) @map("requires_reason")
  requiresStepUp   Boolean   @default(false) @map("requires_step_up")
  requiresApproval Boolean   @default(false) @map("requires_approval")
  description      String    @default("")

  roles            AdminRolePermission[]
  approvalRequests ApprovalRequest[]

  @@map("admin_permission")
}

model AdminRolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permission")
}

/// A grant, not a join row: where it applies, when it expires, who granted it and
/// why, and how it was revoked.
/// RAW SQL REQUIRED (prisma_raw.sql): CHECK granted_by <> actor_id (no self-granting),
/// the revocation and window CHECKs, and the partial unique index on
/// (actor_id, role_id, COALESCE(scope_tenant_id,'*')) WHERE revoked_at IS NULL, plus
/// the partial lookup index. Duplicate live grants make revocation unreliable.
model AdminActorRole {
  id             BigInt    @id @default(autoincrement())
  actorId        BigInt    @map("actor_id")
  roleId         BigInt    @map("role_id")
  scope          Json      @default("{}")
  scopeTenantId  String?   @map("scope_tenant_id") // denormalized hot path
  startsAt       DateTime  @default(now()) @map("starts_at") @db.Timestamptz
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz // null = permanent
  grantedBy      BigInt    @map("granted_by")
  grantedReason  String    @map("granted_reason")
  ticketRef      String?   @map("ticket_ref")
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy      BigInt?   @map("revoked_by")
  revokeReason   String?   @map("revoke_reason")

  actor   AdminActor  @relation("GrantHolder", fields: [actorId], references: [id], onDelete: NoAction)
  role    AdminRole   @relation(fields: [roleId], references: [id], onDelete: NoAction)
  granter AdminActor  @relation("GrantIssuer", fields: [grantedBy], references: [id], onDelete: NoAction)
  revoker AdminActor? @relation("GrantRevoker", fields: [revokedBy], references: [id], onDelete: NoAction)

  @@map("admin_actor_role")
}

/// Which rules were in force when a decision was made. audit_event.policyVersion
/// points here so a past decision stays explainable after the policy changes.
model AdminPolicyVersion {
  id          BigInt    @id @default(autoincrement())
  version     String    @unique
  sourceRef   String    @map("source_ref") // manifest capability.authorizationPolicies[]
  checksum    String
  activatedAt DateTime  @default(now()) @map("activated_at") @db.Timestamptz
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz

  @@map("admin_policy_version")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. RAW SQL REQUIRED (prisma_raw.sql): BEFORE UPDATE / DELETE / TRUNCATE
/// triggers that raise, and the BEFORE INSERT hash-chain trigger. Prisma cannot
/// express this, and application-level guards are bypassed by raw queries and other
/// services. Leave chainSeq, prevHash and rowHash to the trigger.
model AuditEvent {
  id        BigInt   @id @default(autoincrement())
  eventUuid String   @unique @default(dbgenerated("gen_random_uuid()")) @map("event_uuid") @db.Uuid
  chainId   String   @default("default") @map("chain_id")
  chainSeq  BigInt   @default(0) @map("chain_seq") // placeholder; assigned by trigger

  occurredAt DateTime @map("occurred_at") @db.Timestamptz
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  actorId   BigInt?        @map("actor_id")
  actorKind AuditActorKind @default(human) @map("actor_kind")
  /// Null unless impersonating. Never overwrite actorId with the impersonated
  /// identity: that is the most common way impersonation audit is destroyed. The
  /// acted-as subject is usually a customer, not an AdminActor, so this is text in
  /// the same identity space as ImpersonationSession.targetSubjectId — deliberately
  /// not a relation.
  effectiveActorId       String? @map("effective_actor_id")
  impersonationSessionId BigInt? @map("impersonation_session_id")

  tenantId    String? @map("tenant_id")
  environment String
  sourceIp    String? @map("source_ip") @db.Inet
  userAgent   String? @map("user_agent")

  action     String  // admin_permission.key, never free text
  targetType String  @map("target_type")
  targetId   String? @map("target_id")

  reason            String?
  ticketRef         String? @map("ticket_ref")
  approvalRequestId BigInt? @map("approval_request_id")

  requestId      String? @map("request_id")
  correlationId  String? @map("correlation_id")
  idempotencyKey String? @map("idempotency_key")

  result    AuditResult
  errorCode String?     @map("error_code")

  beforeState     Json?   @map("before_state")
  afterState      Json?   @map("after_state")
  beforeHash      String? @map("before_hash")
  afterHash       String? @map("after_hash")
  redactionPolicy String  @default("none") @map("redaction_policy")

  policyVersion String? @map("policy_version")

  prevHash      String? @map("prev_hash") // assigned by trigger
  rowHash       String  @default("") @map("row_hash") // placeholder; assigned by trigger
  hashAlgorithm String  @default("sha256") @map("hash_algorithm")

  actor         AdminActor?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction)
  impersonation ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: NoAction)
  configChanges ConfigChange[]

  @@unique([chainId, chainSeq], map: "audit_event_chain")
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_event_recent")
  @@index([targetType, targetId, occurredAt(sort: Desc)], map: "audit_event_target")
  @@index([actorId, occurredAt(sort: Desc)], map: "audit_event_actor")
  @@index([action, occurredAt(sort: Desc)], map: "audit_event_action")
  // The four partial indexes (tenant, correlation, request, idempotency) are in
  // prisma_raw.sql; Prisma would emit them as full indexes.
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Impersonation
// ---------------------------------------------------------------------------

/// RAW SQL REQUIRED (prisma_raw.sql): the bounded-duration and end-state CHECKs and
/// the unique partial index that allows one live session per real actor.
model ImpersonationSession {
  id                BigInt    @id @default(autoincrement())
  sessionUuid       String    @unique @default(dbgenerated("gen_random_uuid()")) @map("session_uuid") @db.Uuid
  realActorId       BigInt    @map("real_actor_id")
  targetSubjectId   String    @map("target_subject_id")
  targetTenantId    String?   @map("target_tenant_id")
  reason            String
  ticketRef         String?   @map("ticket_ref")
  /// Opting into write impersonation is a deliberate, separately permissioned act.
  readOnly          Boolean   @default(true) @map("read_only")
  scopeRestrictions Json      @default("{}") @map("scope_restrictions")
  startedAt         DateTime  @default(now()) @map("started_at") @db.Timestamptz
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  endedAt           DateTime? @map("ended_at") @db.Timestamptz
  endedReason       String?   @map("ended_reason")
  revokedBy         BigInt?   @map("revoked_by")

  realActor AdminActor  @relation("Impersonator", fields: [realActorId], references: [id], onDelete: NoAction)
  revoker   AdminActor? @relation("ImpersonationRevoker", fields: [revokedBy], references: [id], onDelete: NoAction)
  events    AuditEvent[]

  @@map("impersonation_session")
}

// ---------------------------------------------------------------------------
// Approvals and separation of duties
// ---------------------------------------------------------------------------

model ApprovalRequest {
  id                BigInt        @id @default(autoincrement())
  requestUuid       String        @unique @default(dbgenerated("gen_random_uuid()")) @map("request_uuid") @db.Uuid
  commandKey        String        @map("command_key")
  payload           Json
  payloadHash       String        @map("payload_hash")
  targetType        String        @map("target_type")
  targetId          String?       @map("target_id")
  tenantId          String?       @map("tenant_id")
  requestedBy       BigInt        @map("requested_by")
  requestedAt       DateTime      @default(now()) @map("requested_at") @db.Timestamptz
  reason            String
  requiredApprovals Int           @default(1) @map("required_approvals") @db.SmallInt
  state             ApprovalState @default(pending)
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz
  executedAt        DateTime?     @map("executed_at") @db.Timestamptz
  executionResult   String?       @map("execution_result")

  permission AdminPermission    @relation(fields: [commandKey], references: [key], onDelete: NoAction)
  requester  AdminActor         @relation(fields: [requestedBy], references: [id], onDelete: NoAction)
  decisions  ApprovalDecision[]

  // The pending-queue partial index is in prisma_raw.sql.
  @@map("approval_request")
}

/// Append-only. RAW SQL REQUIRED (prisma_raw.sql): the UPDATE / DELETE / TRUNCATE
/// deny triggers and the separation-of-duties trigger. The requester must not be
/// able to approve their own request, and enforcing that only in application code
/// means the control is absent for anything writing this table directly. The request
/// relation is Restrict, not Cascade: cascading would let a rejection be deleted
/// with its request and re-entered as an approval.
model ApprovalDecision {
  id         BigInt               @id @default(autoincrement())
  requestId  BigInt               @map("request_id")
  approverId BigInt               @map("approver_id")
  decision   ApprovalDecisionKind
  reason     String
  decidedAt  DateTime             @default(now()) @map("decided_at") @db.Timestamptz

  request  ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  approver AdminActor      @relation(fields: [approverId], references: [id], onDelete: NoAction)

  // One approver decides once. Without this a single approver satisfies a
  // two-approval requirement by voting twice.
  @@unique([requestId, approverId], map: "approval_decision_one_per_approver")
  @@map("approval_decision")
}

// ---------------------------------------------------------------------------
// Jobs
// ---------------------------------------------------------------------------

/// RAW SQL REQUIRED (prisma_raw.sql): partial unique index on (kind, idempotency_key)
/// WHERE idempotency_key IS NOT NULL, and the active-queue partial index. A repeated
/// key must return the existing job rather than start a second one.
model AdminJob {
  id              BigInt    @id @default(autoincrement())
  jobUuid         String    @unique @default(dbgenerated("gen_random_uuid()")) @map("job_uuid") @db.Uuid
  kind            String // manifest capability.id where kind = job
  initiatedBy     BigInt    @map("initiated_by")
  tenantId        String?   @map("tenant_id")
  environment     String
  inputSummary    Json      @map("input_summary")
  inputHash       String    @map("input_hash")
  idempotencyKey  String?   @map("idempotency_key")
  correlationId   String?   @map("correlation_id")
  state           JobState  @default(queued)
  totalCount      Int?      @map("total_count")
  processedCount  Int       @default(0) @map("processed_count")
  failedCount     Int       @default(0) @map("failed_count")
  queuedAt        DateTime  @default(now()) @map("queued_at") @db.Timestamptz
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  resultArtifact  String?   @map("result_artifact")
  cancelRequested Boolean   @default(false) @map("cancel_requested")

  initiator           AdminActor           @relation(fields: [initiatedBy], references: [id], onDelete: NoAction)
  failures            AdminJobFailure[]
  dataSubjectRequests DataSubjectRequest[]

  @@map("admin_job")
}

/// Per-item failures. A job reporting only an aggregate count cannot tell the
/// operator which rows to retry. Restrict, not Cascade: deleting the job must not
/// erase its failure history.
model AdminJobFailure {
  id          BigInt   @id @default(autoincrement())
  jobId       BigInt   @map("job_id")
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  errorCode   String   @map("error_code")
  errorDetail String?  @map("error_detail")
  failedAt    DateTime @default(now()) @map("failed_at") @db.Timestamptz

  job AdminJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId, failedAt], map: "admin_job_failure_job")
  @@map("admin_job_failure")
}

// ---------------------------------------------------------------------------
// Saved views and configuration
// ---------------------------------------------------------------------------

/// A shared saved view is a disclosure surface: it can carry one tenant's filter
/// values to another operator. Apply the same row policy when loading it.
model SavedView {
  id         BigInt         @id @default(autoincrement())
  ownerId    BigInt         @map("owner_id")
  route      String // manifest screens[].route
  name       String
  filters    Json           @default("{}")
  columns    Json           @default("[]")
  sort       Json           @default("[]")
  visibility ViewVisibility @default(private)
  tenantId   String?        @map("tenant_id")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  owner AdminActor @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, route, name], map: "saved_view_name_unique")
  @@map("saved_view")
}

/// The same key differs per environment and tenant, so it is unique per scope: the
/// unique expression index (key, environment, COALESCE(tenant_id,'*')) is in
/// prisma_raw.sql. A secret is only ever held as a reference (value_type =
/// 'secret_ref'); the matching CHECK is in prisma_raw.sql too.
model ConfigSetting {
  id          BigInt   @id @default(autoincrement())
  key         String
  value       Json
  valueType   String   @map("value_type")
  /// Set for value_type = secret_ref rows: value is a pointer, never the secret.
  /// Secrets are never displayed; support rotation and revocation instead.
  isSecret    Boolean  @default(false) @map("is_secret")
  tenantId    String?  @map("tenant_id")
  environment String
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("config_setting")
}

/// Unique per (key, environment, tenant): see ConfigSetting.
model FeatureFlag {
  id          BigInt   @id @default(autoincrement())
  key         String
  description String   @default("")
  isEnabled   Boolean  @default(false) @map("is_enabled")
  rollout     Json     @default("{}")
  tenantId    String?  @map("tenant_id")
  environment String
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("feature_flag")
}

/// Every configuration change is a privileged mutation and gets its own history
/// row in addition to its audit event. Keys repeat across environments and tenants,
/// so the row carries the same scope as the row it changed.
model ConfigChange {
  id           BigInt       @id @default(autoincrement())
  targetTable  ConfigTarget @map("target_table")
  targetKey    String       @map("target_key")
  environment  String
  tenantId     String?      @map("tenant_id")
  beforeValue  Json?        @map("before_value")
  afterValue   Json?        @map("after_value")
  changedBy    BigInt       @map("changed_by")
  reason       String
  changedAt    DateTime     @default(now()) @map("changed_at") @db.Timestamptz
  auditEventId BigInt?      @map("audit_event_id")

  changer AdminActor  @relation(fields: [changedBy], references: [id], onDelete: NoAction)
  event   AuditEvent? @relation(fields: [auditEventId], references: [id], onDelete: NoAction)

  @@index([targetTable, targetKey, environment, changedAt(sort: Desc)], map: "config_change_target")
  @@map("config_change")
}

// ---------------------------------------------------------------------------
// Exports and data-subject requests
// ---------------------------------------------------------------------------

model ExportRequest {
  id           BigInt      @id @default(autoincrement())
  exportUuid   String      @unique @default(dbgenerated("gen_random_uuid()")) @map("export_uuid") @db.Uuid
  resource     String
  requestedBy  BigInt      @map("requested_by")
  tenantId     String?     @map("tenant_id")
  filters      Json
  /// Record which policy was applied, not merely that one was. An export is the
  /// easiest way for field-level policy to be silently bypassed.
  rowPolicy    String      @map("row_policy")
  fieldPolicy  String      @map("field_policy")
  reason       String
  state        ExportState @default(queued)
  rowCount     Int?        @map("row_count")
  byteSize     BigInt?     @map("byte_size")
  artifactRef  String?     @map("artifact_ref")
  requestedAt  DateTime    @default(now()) @map("requested_at") @db.Timestamptz
  readyAt      DateTime?   @map("ready_at") @db.Timestamptz
  expiresAt    DateTime    @map("expires_at") @db.Timestamptz
  downloadCount Int        @default(0) @map("download_count")
  lastDownloadedAt DateTime? @map("last_downloaded_at") @db.Timestamptz

  requester           AdminActor           @relation(fields: [requestedBy], references: [id], onDelete: NoAction)
  dataSubjectRequests DataSubjectRequest[]

  @@index([state, expiresAt], map: "export_request_state")
  @@map("export_request")
}

/// Erasure interacts with retention, legal hold and backups. RAW SQL REQUIRED
/// (prisma_raw.sql): the CHECK that a request under legal hold cannot be marked
/// fulfilled; the hold never silently drops it. Access and portability requests link
/// their ExportRequest, erasure its AdminJob.
model DataSubjectRequest {
  id              BigInt    @id @default(autoincrement())
  requestUuid     String    @unique @default(dbgenerated("gen_random_uuid()")) @map("request_uuid") @db.Uuid
  kind            DsrKind
  subjectRef      String    @map("subject_ref")
  tenantId        String?   @map("tenant_id")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  dueAt           DateTime  @map("due_at") @db.Timestamptz
  state           DsrState  @default(open)
  legalHold       Boolean   @default(false) @map("legal_hold")
  assignedTo      BigInt?   @map("assigned_to")
  exportRequestId BigInt?   @map("export_request_id")
  adminJobId      BigInt?   @map("admin_job_id")
  resolution      String?
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz

  assignee      AdminActor?    @relation(fields: [assignedTo], references: [id], onDelete: NoAction)
  exportRequest ExportRequest? @relation(fields: [exportRequestId], references: [id], onDelete: NoAction)
  adminJob      AdminJob?      @relation(fields: [adminJobId], references: [id], onDelete: NoAction)

  @@index([state, dueAt], map: "data_subject_request_queue")
  @@map("data_subject_request")
}
